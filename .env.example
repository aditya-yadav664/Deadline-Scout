# Node.js 24+; run: node --env-file-if-exists=.env server/index.js
HOST=127.0.0.1
PORT=4317
APP_URL=http://localhost:4317
# Use an absolute persistent mounted path when hosting. Keep its encryption key.
DATA_DIR=./data
ENABLE_DEMO=true

# Supabase Auth handles Google sign-in. No service-role key is needed.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Same Web OAuth client configured in Supabase's Google provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Unpacked Chrome extension ID. Required for non-loopback hosting.
EXTENSION_IDS=
# 32 random bytes, base64. Optional locally (a key file is generated in data/).
TOKEN_ENCRYPTION_KEY=

# Switch explicitly to brevo after configuring a verified sender.
EMAIL_PROVIDER=demo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Optional; deterministic extraction works without this.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Generic JavaScript page rechecks use an isolated local Edge/Chromium process.
# Windows Edge is auto-detected. Set a path for other hosts if needed.
BROWSER_EXECUTABLE=

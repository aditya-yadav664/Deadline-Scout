FROM node:24-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends chromium ca-certificates && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY . .
ENV BROWSER_EXECUTABLE=/usr/bin/chromium
ENV HOST=0.0.0.0 PORT=3000 DATA_DIR=/tmp/deadline-scout ENABLE_DEMO=false NODE_ENV=production CLOUD_MODE=true
EXPOSE 3000
CMD ["node", "server/index.js"]
